      "description": "Blockchain proof of concept",
      "cost": 600000,
      "benefit": 200000,
      "priority": null,
      "id": "proj_007"
    }
  ],
  "constraints": [
    {
      "type": "mutually_exclusive",
      "projects": [
        "AI Research",
        "Blockchain POC"
      ],
      "description": "AI Research and Blockchain POC cannot both be selected due to overlapping team resources"
    },
    {
      "type": "dependency",
      "projects": [
        "Cloud Migration",
        "Mobile App"
      ],
      "description": "Mobile App requires Cloud Migration infrastructure to be in place first"
    }
  ]
