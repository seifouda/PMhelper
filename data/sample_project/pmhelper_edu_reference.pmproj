    "risks": [
      {"id": "R-001", "name": "Lead Developer Extended Unavailability", "description": "Omar Hassan El-Rashidy becomes unavailable for 4+ weeks. Single point of failure for all technical delivery.", "probability": 0.15, "impact": 200000, "category": "Schedule", "prob_score": 2, "impact_score": 5, "risk_rank": 1, "response_strategy": "Mitigate", "response_description": "Comprehensive documentation. Cross-training Jr Dev from Month 6. GitHub history as knowledge base.", "response_owner": "Ahmed Samir Khalil", "response_cost": 12000, "residual_probability": 1.0, "residual_impact": 4.0, "trigger_conditions": "Unplanned absences >3 consecutive days.", "contingency_plan": "Activate Jr Dev on routine tasks; sponsor approves emergency contractor from management reserve."},
      {"id": "R-002", "name": "Scope Creep from New PM Curriculum Requirements", "description": "Faculty or sponsor requests significant new features not in original scope during Phases 3-6.", "probability": 0.50, "impact": 80000, "category": "Scope", "prob_score": 3, "impact_score": 4, "risk_rank": 2, "response_strategy": "Mitigate", "response_description": "Formal change control. PM defers requests >2 days to V3 backlog without escalation.", "response_owner": "Ahmed Samir Khalil", "response_cost": 3000, "residual_probability": 2.0, "residual_impact": 2.0, "trigger_conditions": "More than 2 informal feature requests per sprint.", "contingency_plan": "Log in GitHub Issues v3-backlog label. Present quarterly to Sponsor for prioritization."},
      {"id": "R-003", "name": "PyInstaller Library Compatibility Failures", "description": "Known incompatibilities between PyInstaller frozen imports and scipy/numpy cause runtime errors. MATERIALIZED — Issue I-001 resolved with patch_scipy.py.", "probability": 0.35, "impact": 30000, "category": "Quality", "prob_score": 3, "impact_score": 2, "risk_rank": 8, "response_strategy": "Mitigate", "response_description": "patch_scipy.py wraps scipy NameError in try/except. build_production.ps1 auto-applies at step 2b.", "response_owner": "Omar Hassan El-Rashidy", "response_cost": 5000, "residual_probability": 1.0, "residual_impact": 2.0, "trigger_conditions": "New library added or Python version bump.", "contingency_plan": "Add try/except around offending code. Pin PyInstaller to last known-good version if needed."},
      {"id": "R-004", "name": "GitHub Copilot Unavailability or Price Increase", "description": "Copilot subscription cancelled or repriced beyond budget. Represents 30-40% of development velocity.", "probability": 0.15, "impact": 60000, "category": "Cost", "prob_score": 2, "impact_score": 3, "risk_rank": 6, "response_strategy": "Mitigate", "response_description": "Alternative tools documented: Claude.ai, GPT-4 Turbo, Cursor IDE. Budget includes 20% buffer.", "response_owner": "Omar Hassan El-Rashidy", "response_cost": 2000, "residual_probability": 1.0, "residual_impact": 2.0, "trigger_conditions": "Pricing change announcement or 3+ days service degradation.", "contingency_plan": "Switch to Cursor + Claude.ai. Expect -15% velocity with alternatives."},
      {"id": "R-005", "name": "Render.com Infrastructure Change", "description": "Render.com increases limitations or pricing, making current deployment uneconomical.", "probability": 0.25, "impact": 25000, "category": "Cost", "prob_score": 3, "impact_score": 2, "risk_rank": 10, "response_strategy": "Transfer", "response_description": "Fallback options: Railway.app, Fly.io, Heroku. Docker config enables migration in <4 hours.", "response_owner": "Omar Hassan El-Rashidy", "response_cost": 1500, "residual_probability": 1.0, "residual_impact": 1.0, "trigger_conditions": "Response time consistently >5s or pricing announcement.", "contingency_plan": "Execute provider migration. Update configuration files. Expected time: 4 hours."},
      {"id": "R-006", "name": "Python Version Incompatibility in Labs", "description": "University labs run Python 3.6/3.7 (outdated); application requires 3.8+.", "probability": 0.20, "impact": 40000, "category": "Quality", "prob_score": 2, "impact_score": 3, "risk_rank": 7, "response_strategy": "Mitigate", "response_description": "PyInstaller exe bundles Python 3.11 — immune to lab Python version. PyPI enforces 3.8+ requirement.", "response_owner": "Ahmed Samir Khalil", "response_cost": 2000, "residual_probability": 1.0, "residual_impact": 1.0, "trigger_conditions": "Faculty reports installation failure.", "contingency_plan": "Direct faculty to exe distribution for lab use."},
      {"id": "R-007", "name": "WebView2 Not Available in Lab Environments", "description": "Plotly interactive charts need WebView2. Some lab builds lack it. PARTIALLY MATERIALIZED — graceful fallback implemented.", "probability": 0.30, "impact": 20000, "category": "Quality", "prob_score": 3, "impact_score": 2, "risk_rank": 9, "response_strategy": "Accept", "response_description": "PlotlyChartFrame defaults to Matplotlib if WebView2 unavailable. Educational value preserved.", "response_owner": "Omar Hassan El-Rashidy", "response_cost": 0, "residual_probability": 2.0, "residual_impact": 1.0, "trigger_conditions": "Application startup on machine without Edge/WebView2.", "contingency_plan": "No action needed — fallback already active. Optional: include WebView2 bootstrapper in release."},
      {"id": "R-008", "name": "EVM Formula Misalignment with PMBOK Revision", "description": "PMI releases revised PMBOK or exam content outline with different EVM formulas.", "probability": 0.10, "impact": 50000, "category": "Quality", "prob_score": 2, "impact_score": 3, "risk_rank": 5, "response_strategy": "Mitigate", "response_description": "Prof. Youssef monitors PMI curriculum changes. Monthly content review sessions.", "response_owner": "Prof. Youssef Ibrahim Tawfik", "response_cost": 5000, "residual_probability": 1.0, "residual_impact": 2.0, "trigger_conditions": "PMI curriculum announcement.", "contingency_plan": "Update evm_calculations_edu.py and release as patch version."},
      {"id": "R-009", "name": "Systematic Project Duration Underestimate", "description": "Project consistently over plan due to educational scaffolding complexity. MATERIALIZED — CPI=0.92 at Month 10, ~EGP 80,000 overrun.", "probability": 0.60, "impact": 80000, "category": "Cost", "prob_score": 4, "impact_score": 4, "risk_rank": 3, "response_strategy": "Accept", "response_description": "Contingency reserve (EGP 122,652) absorbs ~EGP 80,000 overrun. Management reserve not required.", "response_owner": "Ahmed Samir Khalil", "response_cost": 0, "residual_probability": 3.0, "residual_impact": 2.0, "trigger_conditions": "CPI < 0.95 for two consecutive months (TRIGGER MISSED at Month 4).", "contingency_plan": "Use remaining contingency (EGP 42,652) for months 11-13. Request management reserve if exhausted."},
      {"id": "R-010", "name": "Institutional Adoption Lower Than Projected", "description": "Universities adopt at slower rate than Business Case projection (target: 3 by Year 1, 8 by Year 2).", "probability": 0.40, "impact": 300000, "category": "Other", "prob_score": 3, "impact_score": 4, "risk_rank": 4, "response_strategy": "Mitigate", "response_description": "Free model removes cost barrier. Faculty beta program. Reference project reduces adoption effort. Prof. Youssef network.", "response_owner": "Dr. Karim Naguib", "response_cost": 15000, "residual_probability": 2.0, "residual_impact": 3.0, "trigger_conditions": "<1 institutional adoption by Month 3 post-launch; <50 GitHub stars by Month 6 post-launch.", "contingency_plan": "Activate marketing: conference, LinkedIn, direct faculty outreach. Revisit NPV assumptions at 12-month review."},
      {"id": "R-011", "name": "Angular Framework Major Version Incompatibility", "description": "Angular major version release with breaking changes requires significant web frontend rework.", "probability": 0.20, "impact": 35000, "category": "Schedule", "prob_score": 2, "impact_score": 2, "risk_rank": 12, "response_strategy": "Mitigate", "response_description": "Pin Angular LTS version in package.json. Review upgrades before applying.", "response_owner": "Omar Hassan El-Rashidy", "response_cost": 1000, "residual_probability": 1.0, "residual_impact": 2.0, "trigger_conditions": "Angular announces major breaking changes.", "contingency_plan": "Defer upgrade to V3. Maintain current LTS."},
      {"id": "R-012", "name": "PyPI Package Name Conflict", "description": "Package name 'pmhelper' on PyPI taken by another project. RESOLVED — name confirmed available and registered.", "probability": 0.10, "impact": 10000, "category": "Scope", "prob_score": 1, "impact_score": 2, "risk_rank": 15, "response_strategy": "Avoid", "response_description": "CLOSED. Package name registered. pyproject.toml configured correctly.", "response_owner": "Omar Hassan El-Rashidy", "response_cost": 0, "residual_probability": 1.0, "residual_impact": 1.0, "trigger_conditions": "PyPI submission rejection.", "contingency_plan": "Alternative names: pmhelper-edu, pmhelper-pm."},
