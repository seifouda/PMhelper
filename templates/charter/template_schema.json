{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Charter Template Schema",
  "type": "object",
  "required": ["template_id", "template_name", "template_version", "sections"],
  "properties": {
    "template_id": {
      "type": "string",
      "description": "Unique identifier for the template"
    },
    "template_name": {
      "type": "string",
      "description": "Human-readable name for the template"
    },
    "template_version": {
      "type": "string",
      "description": "Version number of the template"
    },
    "description": {
      "type": "string",
      "description": "Description of the template purpose"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/section"
      }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "required": ["section_id", "section_title", "section_order", "fields"],
      "properties": {
        "section_id": {
          "type": "string"
        },
        "section_title": {
          "type": "string"
        },
        "section_order": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["field_id", "field_label", "field_type"],
      "properties": {
        "field_id": {
          "type": "string"
        },
        "field_label": {
          "type": "string"
        },
        "field_type": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "date",
            "currency",
            "number",
            "dropdown",
            "table"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "placeholder": {
          "type": "string"
        },
        "max_length": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "help_text": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": {
          "type": ["string", "number", "boolean"]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["text", "number", "date", "dropdown"]
              },
              "width": {
                "type": "integer"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
