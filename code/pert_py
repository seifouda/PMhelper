#!/usr/bin/env python3
"""
PERT and CPM Analysis

This script performs Program Evaluation and Review Technique (PERT) and Critical Path Method (CPM) analysis.
It reads activity data from a CSV file with optimistic, most likely, and pessimistic time estimates.
The program first performs CPM using most likely times, then PERT analysis with expected times.
"""

import networkx as nx
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
from tabulate import tabulate
from collections import defaultdict
import pandas as pd
import numpy as np
from scipy.stats import norm
import csv
import sys
import os
import math

def load_activities_from_csv():
    """
    Prompt the user to input the CSV file path, validate it exists, and load activities from the CSV file for PERT analysis.
    
    Expected CSV format:
    id,predecessors,optimistic,most_likely,pessimistic
    A,,2,3,5
    B,,3,4,6
    C,A,1,2,4
    ...
    
    Returns:
        List of dictionaries with activity data including PERT times
    """
    # Get CSV file path
    while True:
        csv_file = input("Enter the path to your CSV file: ").strip()
        if os.path.exists(csv_file):
            break
        else:
            print(f"Error: File '{csv_file}' not found. Please try again.")
    
    activities = []
    
    try:
        # Read CSV file
        df = pd.read_csv(csv_file)
        
        # Check required columns
        required_columns = ['id', 'predecessors', 'optimistic', 'most_likely', 'pessimistic']
        for col in required_columns:
            if col not in df.columns:
                print(f"Error: Required column '{col}' not found in CSV file")
                sys.exit(1)
        
        for _, row in df.iterrows():
            # Convert time estimates to numbers
            try:
                optimistic = int(row['optimistic'])
                most_likely = int(row['most_likely'])
                pessimistic = int(row['pessimistic'])
            except ValueError:
                print(f"Error: Time estimates for activity {row['id']} must be numbers")
                sys.exit(1)
            
            # Validate time estimates
            if not (optimistic <= most_likely <= pessimistic):
                print(f"Error: Invalid time estimates for activity {row['id']}")
                print("Optimistic <= Most Likely <= Pessimistic is required")
                sys.exit(1)
            
            # Process predecessors (allow empty/NaN)
            predecessors_raw = row.get('predecessors', '')
            if pd.isna(predecessors_raw) or str(predecessors_raw).strip().lower() in ('', 'nan', 'none'):
                predecessors = []
            else:
                predecessors = [p.strip() for p in str(predecessors_raw).split(',') if p.strip()]
            
            activities.append({
                'id': str(row['id']).strip(),
                'predecessors': predecessors,  # Now storing as list
                'optimistic': optimistic,
                'most_likely': most_likely,
                'pessimistic': pessimistic
            })
    
    except FileNotFoundError:
        print(f"Error: File '{csv_file}' not found")
        sys.exit(1)
    except Exception as e:
        print(f"Error reading CSV file: {e}")
        sys.exit(1)
    
    # Display loaded data as table
    print(f"\nLoaded Data from CSV:")
    print("=" * 80)
    
    table_data = []
    for activity in activities:
        predecessors_str = ', '.join(activity['predecessors']) if activity['predecessors'] else 'None'
        table_data.append([
            activity['id'],
            predecessors_str,
            activity['optimistic'],
            activity['most_likely'],
            activity['pessimistic']
        ])
    
    headers = ["Activity ID", "Predecessors", "Optimistic", "Most Likely", "Pessimistic"]
    print(tabulate(table_data, headers=headers, tablefmt="grid"))
    
    
    print("\nGenerating network visualization...")
    try:
        # Build network using most likely times for initial visualization
        G_preview = build_network(activities, duration_type='most_likely')
        visualize_network(G_preview, duration_type='most_likely')
        print("Network visualization displayed successfully.")
    except Exception as e:
        print(f"Warning: Could not display network visualization: {e}")
        print("Continuing with data loading...")
    
    
    return activities

def build_network(activities, duration_type='most_likely'):
    """
    Build a directed graph network from activity data.
    
    Args:
        activities: List of dictionaries with activity data
        duration_type: 'most_likely' or 'expected' for the duration to use
    
    Returns:
        A NetworkX DiGraph object
    """
    G = nx.DiGraph()
    
    # First, collect all activity IDs
    all_activity_ids = {activity['id'] for activity in activities}
    
    # Add all activities as nodes with duration attribute
    for activity in activities:
        if duration_type == 'most_likely':
            duration = activity['most_likely']
        elif duration_type == 'expected':
            duration = activity.get('expected_time', activity['most_likely'])
        else:
            duration = activity[duration_type]
        
        G.add_node(activity['id'], duration=duration)
        
        # Add PERT-specific attributes if available
        for attr in ['optimistic', 'most_likely', 'pessimistic', 'expected_time', 'variance']:
            if attr in activity:
                G.nodes[activity['id']][attr] = activity[attr]
    
    # Check for missing predecessors and collect invalid ones
    missing_predecessors = []
    valid_activities = []
    
    for activity in activities:
        invalid_preds = []
        valid_preds = []
        
        # Ensure predecessors is a list
        predecessors = activity['predecessors']
        if not isinstance(predecessors, list):
            predecessors = [predecessors] if predecessors else []
        
        for predecessor in predecessors:
            if predecessor in all_activity_ids:
                valid_preds.append(predecessor)
            else:
                invalid_preds.append(predecessor)
                missing_predecessors.append((activity['id'], predecessor))
        
        # Update activity with only valid predecessors
        activity_copy = activity.copy()
        activity_copy['predecessors'] = valid_preds
        valid_activities.append(activity_copy)
        
        if invalid_preds:
            print(f"Warning: Activity '{activity['id']}' references non-existent predecessor(s): {invalid_preds}")
    
    # If there are missing predecessors, ask user how to proceed
    if missing_predecessors:
        print(f"\nFound {len(missing_predecessors)} missing predecessor reference(s):")
        for activity_id, missing_pred in missing_predecessors:
            print(f"  Activity '{activity_id}' -> Missing predecessor '{missing_pred}'")
        
        print("\nOptions:")
        print("1. Continue with missing predecessors ignored")
        print("2. Exit to fix the CSV file")
        
        while True:
            choice = input("Enter your choice (1 or 2): ").strip()
            if choice == '1':
                print("Continuing with missing predecessors ignored...")
                break
            elif choice == '2':
                print("Please fix your CSV file and run the program again.")
                sys.exit(1)
            else:
                print("Please enter 1 or 2.")
    
    # Add edges based on valid predecessor relationships
    for activity in valid_activities:
        for predecessor in activity['predecessors']:
            G.add_edge(predecessor, activity['id'])
    
    return G

def visualize_network(G, critical_activities=None, duration_type='most_likely'):
    """
    Visualize the PERT project network with circular nodes divided by horizontal diameter.
    Upper half shows ID, lower half shows duration.
    Arrows are straight lines.

    Args:
        G: NetworkX DiGraph
        critical_activities: List of activities on the critical path (ignored)
        duration_type: Type of duration to display ('most_likely', 'expected_time', etc.)
    """
    import matplotlib.patches as mpatches
    import matplotlib.pyplot as plt
    import networkx as nx

    # Create a hierarchical layout
    pos = {}

    # Get topological generations (layers of nodes)
    try:
        generations = list(nx.topological_generations(G))
    except nx.NetworkXError:
        # If graph has cycles, fall back to spring layout
        print("Warning: Graph contains cycles, using spring layout instead of hierarchical layout")
        pos = nx.spring_layout(G, k=3, iterations=50)
        generations = None

    if generations:
        # Set x-coordinates by generation and y-coordinates to spread nodes vertically
        for i, gen in enumerate(generations):
            # Sort nodes within generation to make visualization more predictable
            sorted_gen = sorted(gen)

            # Calculate vertical positions
            for j, node in enumerate(sorted_gen):
                y_pos = (j - len(sorted_gen) / 2 + 0.5) * 4  # Center nodes vertically
                pos[node] = (i * 3, y_pos)  # Increase spacing between generations

    plt.figure(figsize=(14, 10))

    # Node parameters
    node_radius = 0.4

    # Draw edges as straight lines
    for u, v in G.edges():
        x1, y1 = pos[u]
        x2, y2 = pos[v]

        # Calculate edge points on circle circumference
        dx = x2 - x1
        dy = y2 - y1
        distance = (dx ** 2 + dy ** 2) ** 0.5

        # Normalize direction vector
        if distance > 0:
            dx_norm = dx / distance
            dy_norm = dy / distance

            # Start point (edge of source circle)
            start_x = x1 + node_radius * dx_norm
            start_y = y1 + node_radius * dy_norm

            # End point (edge of target circle)
            end_x = x2 - node_radius * dx_norm
            end_y = y2 - node_radius * dy_norm

            # Draw straight arrow
            plt.annotate("",
                        xy=(end_x, end_y), xycoords='data',
                        xytext=(start_x, start_y), textcoords='data',
                        arrowprops=dict(arrowstyle="->", color="black", lw=1.5))

    # Draw nodes as circles with horizontal diameter
    for node in G.nodes():
        x, y = pos[node]

        # Special colors for START and END nodes
        if node == 'START':
            color = 'lightgreen'
        elif node == 'END':
            color = 'orange'
        else:
            color = 'lightblue'

        # Draw circle
        circle = plt.Circle((x, y), node_radius,
                            fill=True, color=color, alpha=0.7,
                            edgecolor='black', linewidth=1.5, zorder=3)
        plt.gca().add_patch(circle)

        # Special handling for START and END nodes
        if node in ['START', 'END']:
            # For START and END nodes, just show the text without horizontal diameter
            display_text = 'Start' if node == 'START' else 'End'
            plt.text(x, y, display_text,
                    horizontalalignment='center', verticalalignment='center',
                    fontsize=10, fontweight='bold', zorder=5)
        else:
            # Draw horizontal diameter
            plt.plot([x - node_radius, x + node_radius], [y, y],
                    color='black', linewidth=1.2, zorder=4)

            # Add text in upper half (ID)
            plt.text(x, y + node_radius / 2, node,
                    horizontalalignment='center', verticalalignment='center',
                    fontsize=10, fontweight='bold', zorder=5)

            # Get duration based on duration_type
            if duration_type in G.nodes[node]:
                duration = G.nodes[node][duration_type]
            else:
                duration = G.nodes[node].get('duration', G.nodes[node].get('most_likely', 0))

            # Add text in lower half (Duration)
            # Format duration to show decimal places if it's a float
            if isinstance(duration, float):
                duration_text = f"{duration:.1f}" if duration % 1 != 0 else f"{int(duration)}"
            else:
                duration_text = str(duration)
                
            plt.text(x, y - node_radius / 2, duration_text,
                    horizontalalignment='center', verticalalignment='center',
                    fontsize=9, zorder=5)

    # Add legend for node format
    duration_label = duration_type.replace('_', ' ').title()
    plt.figtext(0.01, 0.01, f"Node Format: ID (top) / {duration_label} (bottom)", fontsize=10)

    plt.title("PERT Project Network Diagram")
    plt.axis('equal')
    plt.axis('off')
    plt.tight_layout()
    plt.show()

def forward_pass(G):
    """
    Perform forward pass to calculate Early Start (ES) and Early Finish (EF).
    
    Args:
        G: NetworkX DiGraph with activities
    
    Returns:
        Updated graph with ES and EF attributes
    """
    # Check for cycles before proceeding
    if not nx.is_directed_acyclic_graph(G):
        print("Error: The project network contains a cycle!")
        print("This indicates a circular dependency between activities.")
        
        # Try to find and report the cycle
        try:
            cycle = nx.find_cycle(G, orientation='original')
            cycle_activities = [edge[0] for edge in cycle] + [cycle[-1][1]]
            print(f"Cycle detected: {' -> '.join(cycle_activities)}")
        except nx.NetworkXNoCycle:
            print("Could not identify the specific cycle.")
        
        raise nx.NetworkXUnfeasible("Graph contains a cycle")
    
    # Find activities with no predecessors
    start_activities = [node for node in G.nodes() if G.in_degree(node) == 0]
    
    if not start_activities:
        raise nx.NetworkXUnfeasible("No start activities found (all activities have predecessors)")
    
    # Initialize early times
    nx.set_node_attributes(G, 0, 'ES')
    nx.set_node_attributes(G, 0, 'EF')
    
    # Process nodes in topological order
    try:
        topo_order = list(nx.topological_sort(G))
    except nx.NetworkXUnfeasible as e:
        raise nx.NetworkXUnfeasible(f"Cannot perform topological sort: {e}")
    
    for node in topo_order:
        duration = G.nodes[node]['duration']
        
        # For start activities, ES = 0
        if node in start_activities:
            G.nodes[node]['ES'] = 0
        # For others, ES = max EF of predecessors
        else:
            pred_ef = [G.nodes[pred]['EF'] for pred in G.predecessors(node)]
            G.nodes[node]['ES'] = max(pred_ef) if pred_ef else 0
        
        # EF = ES + duration
        G.nodes[node]['EF'] = G.nodes[node]['ES'] + duration
    
    return G

def backward_pass(G):
    """
    Perform backward pass to calculate Late Start (LS) and Late Finish (LF).
    
    Args:
        G: NetworkX DiGraph with activities having ES and EF attributes
    
    Returns:
        Updated graph with LS and LF attributes
    """
    
    # Find activities with no successors (end activities)
    end_activities = [node for node in G.nodes() if G.out_degree(node) == 0]
    
    # Initialize late times - set all LF to the maximum EF (project duration)
    project_duration = max([G.nodes[node]['EF'] for node in G.nodes()])
    nx.set_node_attributes(G, project_duration, 'LF')
    nx.set_node_attributes(G, project_duration, 'LS')
    
    # Process nodes in reverse topological order
    for node in reversed(list(nx.topological_sort(G))):
        duration = G.nodes[node]['duration']
        
        # For end activities, LF = project duration
        if node in end_activities:
            G.nodes[node]['LF'] = project_duration
        # For others, LF = min LS of successors
        else:
            succ_ls = [G.nodes[succ]['LS'] for succ in G.successors(node)]
            G.nodes[node]['LF'] = min(succ_ls) if succ_ls else project_duration
        
        # LS = LF - duration
        calculated_ls = G.nodes[node]['LF'] - duration
        G.nodes[node]['LS'] = calculated_ls
        
    return G

def calculate_float(G):
    """
    Calculate float (slack) for each activity.
    
    Args:
        G: NetworkX DiGraph with ES, EF, LS, LF attributes
    
    Returns:
        Updated graph with float attribute
    """
    for node in G.nodes():
        # Total Float = LS - ES or LF - EF (they are the same)
        calculated_float = G.nodes[node]['LS'] - G.nodes[node]['ES']
        G.nodes[node]['float'] = max(0,calculated_float)  # Ensure float is non-negative
    return G

def identify_critical_path(G):
    """
    Identify the critical path (activities with zero float).
    
    Args:
        G: NetworkX DiGraph with float attributes
    
    Returns:
        Tuple of (critical_paths, critical_activities)
    """
    critical_activities = [node for node in G.nodes() if G.nodes[node]['float'] == 0]
    
    # Create a subgraph of only critical activities
    critical_subgraph = G.subgraph(critical_activities)
    
    # Find all paths from start to end nodes in the critical subgraph
    critical_paths = []
    start_nodes = [node for node in critical_subgraph.nodes() if critical_subgraph.in_degree(node) == 0]
    end_nodes = [node for node in critical_subgraph.nodes() if critical_subgraph.out_degree(node) == 0]
    
    for start in start_nodes:
        for end in end_nodes:
            try:
                paths = list(nx.all_simple_paths(critical_subgraph, start, end))
                critical_paths.extend(paths)
            except nx.NetworkXNoPath:
                pass
    
    # Find the longest critical path
        longest_path = []
        max_duration = 0
        
        for path in critical_paths:
            path_duration = sum(G.nodes[node]['duration'] for node in path)
            if path_duration > max_duration:
                max_duration = path_duration
                longest_path = path
        
        # Return the longest path as a single-item list to maintain compatibility
        return [longest_path] if longest_path else [], critical_activities

