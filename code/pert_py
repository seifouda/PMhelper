def calculate_project_variance(G, critical_path):
    """
    Calculate the total project variance based on critical path activities.
    
    Args:
        G: NetworkX DiGraph with variance attributes
        critical_path: List of critical path activities
    
    Returns:
        Total project variance
    """
    total_variance = 0
    for activity in critical_path:
        if 'variance' in G.nodes[activity]:
            total_variance += G.nodes[activity]['variance']
    
    return round(total_variance, 2)

def probability_analysis_menu(G, critical_paths):
    """
    Interactive menu for PERT probability analysis.
    
    Args:
        G: NetworkX DiGraph with PERT attributes
        critical_paths: List of critical paths
    """
    if not critical_paths:
        print("No critical path found. Cannot perform probability analysis.")
        return
    
    # Use the first critical path for analysis
    critical_path = critical_paths[0]
    
    # Calculate project statistics
    project_duration = max([G.nodes[node]['EF'] for node in G.nodes()])
    project_variance = calculate_project_variance(G, critical_path)
    project_std = np.sqrt(project_variance)
    
    print(f"\nPERT Probability Analysis")
    print("=" * 50)
    print(f"Project Expected Duration: {project_duration:.2f} time units")
    print(f"Project Standard Deviation: {project_std:.2f} time units")
    print(f"Project Variance: {project_variance:.2f}")
    
    while True:
        print(f"\nProbability Analysis Options:")
        print("1. Calculate probability of completing by a specific time")
        print("2. Find time for a specific completion probability")
        print("3. Show probability distribution")
        print("4. Return to main menu")
        
        choice = input("Enter your choice (1-4): ").strip()
        
        if choice == '1':
            try:
                target_time = float(input(f"Enter target completion time: "))
                z_score = (target_time - project_duration) / project_std
                probability = norm.cdf(z_score)
                print(f"Probability of completing by time {target_time:.1f}: {probability:.4f} ({probability*100:.2f}%)")
            except ValueError:
                print("Please enter a valid number.")
        
        elif choice == '2':
            try:
                target_prob = float(input("Enter desired probability (0-1): "))
                if 0 <= target_prob <= 1:
                    z_score = norm.ppf(target_prob)
                    completion_time = project_duration + z_score * project_std
                    print(f"Time needed for {target_prob*100:.1f}% probability: {completion_time:.2f} time units")
                else:
                    print("Probability must be between 0 and 1.")
            except ValueError:
                print("Please enter a valid number.")
        
        elif choice == '3':
            # Generate probability distribution chart
            times = np.linspace(project_duration - 3*project_std, project_duration + 3*project_std, 100)
            probabilities = norm.pdf(times, project_duration, project_std)
            
            plt.figure(figsize=(10, 6))
            plt.plot(times, probabilities, 'b-', linewidth=2, label='Probability Density')
            plt.axvline(project_duration, color='r', linestyle='--', label=f'Expected Duration ({project_duration:.2f})')
            plt.fill_between(times, probabilities, alpha=0.3)
            plt.xlabel('Project Duration (time units)')
            plt.ylabel('Probability Density')
            plt.title('Project Completion Time Distribution')
            plt.legend()
            plt.grid(True, alpha=0.3)
            plt.tight_layout()
            plt.show()
        
        elif choice == '4':
            break
        
        else:
            print("Invalid choice. Please enter 1, 2, 3, or 4.")

