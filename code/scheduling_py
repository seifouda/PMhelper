def load_csv_data(file_path: str) -> pd.DataFrame:
        """
        Load project data from CSV file.
        
        Args:
            file_path: Path to the CSV file
            
        Returns:
            DataFrame with project task data
        """
        try:
            df = pd.read_csv(file_path)
            print(f"Successfully loaded {len(df)} tasks from {file_path}")
            
            # Handle predecessor format conversion
            # Convert empty strings and handle different formats
            def clean_predecessors(pred):
                if pd.isna(pred) or pred == '' or pred == 'nan':
                    return ''
                return str(pred).strip()
            
            df['Predecessors'] = df['Predecessors'].apply(clean_predecessors)
            
            return df
            
        except FileNotFoundError:
            print(f"Error: File '{file_path}' not found.")
            return None
        except Exception as e:
            print(f"Error loading CSV file: {str(e)}")
            return None

def get_csv_file_path() -> str:
        """
        Get CSV file path from user input.
        
        Returns:
            Path to CSV file
        """
        while True:
            file_path = input("Please enter the path to your CSV file: ").strip()
            
            if not file_path:
                print("Please provide a valid file path.")
                continue
                
            # Remove quotes if user included them
            file_path = file_path.strip('"').strip("'")
            
            return file_path

