    def load_sample_data(self):
        """Load sample project data"""
        sample_data = [
            ("A", "Design Phase", "5", "","2"),
            ("B", "Requirements Analysis", "3", "", "1"),
            ("C", "Architecture Design", "4", "A,B", "3"),
            ("D", "Database Design", "2", "B","1"),
            ("E", "Frontend Development", "6", "C", "4"),
            ("F", "Backend Development", "8", "C,D","3"),
