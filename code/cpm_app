    def update_cpm_graph_with_rcps(self):
        """Update CPM graph durations to match RCPS schedule."""
        if not hasattr(self.analyzer, 'G') or self.analyzer.G is None:
            return
        if not hasattr(self, 'last_rcps_table') or self.last_rcps_table is None:
            return
        rcps_df = self.last_rcps_table
        for idx, row in rcps_df.iterrows():
            act_id = row['id']
            if act_id in self.analyzer.G.nodes and act_id not in ['RA', 'RS']:
                try:
                    self.analyzer.G.nodes[act_id]['duration'] = int(row['duration'])
                except Exception:
                    pass
    
    
