                    cell.set_text_props(weight='bold', size=14)
                    cell.set_height(0.08)
                else:
                    cell.set_height(0.08)
            
            ax.set_title(title, fontsize=20, fontweight='bold', pad=20)
        
        fig.tight_layout()
        fig.subplots_adjust(hspace=0.4)
