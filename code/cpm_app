    def run_rcps_tables(self):
        """Run CPMAnalyzer logic and plot schedule tables in RCPS tab."""
        try:
            # Check if analysis has been performed
            if not hasattr(self.analyzer, 'G') or self.analyzer.G is None:
                messagebox.showwarning("Warning", "Please run the CPM analysis first.")
                return

            # Get resource limit from user input
            try:
                resource_limit = int(self.resource_limit_var.get())
            except Exception:
                messagebox.showerror("Error", "Invalid resource limit.")
                return
            
            # --- Data validation: resource limit must be >= max resource demand ---
            # Find max resource demand in activities
            max_resource_demand = 0
            for node in self.analyzer.G.nodes():
                if node not in ['START', 'END']:
                    demand = self.analyzer.G.nodes[node].get('resource_demand', 0)
                    try:
                        demand = int(demand)
                    except Exception:
                        demand = 0
                    if demand > max_resource_demand:
                        max_resource_demand = demand
            if resource_limit < max_resource_demand:
                messagebox.showwarning(
                    "Resource Limit Too Low",
                    f"Resource limit ({resource_limit}) is less than the maximum resource demand ({max_resource_demand}) of any activity.\n"
                    "Please enter a resource limit greater than or equal to the largest resource demand."
                )
                return
            # --- End validation ---


            # Generate CPM Gantt DataFrame
            df_gantt = self.generate_gantt_chart(self.analyzer.G, self.analyzer.critical_activities)
            # Call CPMAnalyzer logic to build both tables with priority rules
            priority_rule = self.priority_rule_var.get()
            cpm_table, time_cols, critical_ids = self.analyzer.build_cpm_schedule_table(df_gantt, resource_limit)
            rcps_table, actual_starts, critical_ids2 = self.analyzer.rcps_heuristic_schedule_table(df_gantt, resource_limit, priority_rule)
            
            # --- Add this block to pad CPM table columns if needed ---
            cpm_time_cols = [col for col in cpm_table.columns if isinstance(col, int)]
            rcps_time_cols = [col for col in rcps_table.columns if isinstance(col, int)]
            max_time_rcps = max(rcps_time_cols) if rcps_time_cols else 0
            max_time_cpm = max(cpm_time_cols) if cpm_time_cols else 0
            if max_time_rcps > max_time_cpm:
                # Add extra columns to CPM table
                for t in range(max_time_cpm + 1, max_time_rcps + 1):
                    cpm_table[t] = ''
                # Ensure columns are in correct order
                non_time_cols = [col for col in cpm_table.columns if not isinstance(col, int)]
                all_time_cols = list(range(1, max_time_rcps + 1))
                cpm_table = cpm_table[non_time_cols + all_time_cols]
                time_cols = all_time_cols  # Update time_cols for plotting/highlighting
            # --- End block ---
            
            # Plot the tables
            self.plot_schedule_tables(cpm_table, rcps_table, time_cols, critical_ids, actual_starts, df_gantt)
            # Switch to RCPS tab
            self.notebook.select(self.notebook.tabs()[-2])  # or use the correct tab index if needed

        except Exception as e:
            messagebox.showerror("Error", f"RCPS scheduling failed: {str(e)}")

    
