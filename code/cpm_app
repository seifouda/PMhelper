        self.fig_crashed = plt.Figure(figsize=(12, 8))
        self.canvas_crashed = FigureCanvasTkAgg(self.fig_crashed, results_frame)
        self.canvas_crashed.get_tk_widget().pack(fill=tk.BOTH, expand=True)
        
        # Scrollable area for crash step diagrams
        crash_steps_area = ttk.Frame(results_frame)
        crash_steps_area.pack(fill=tk.BOTH, expand=True)

        self.crash_steps_canvas = tk.Canvas(crash_steps_area, height=600)
        self.crash_steps_canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        crash_steps_scrollbar = ttk.Scrollbar(crash_steps_area, orient="vertical", command=self.crash_steps_canvas.yview)
        crash_steps_scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        self.crash_steps_canvas.configure(yscrollcommand=crash_steps_scrollbar.set)

        # Frame inside the canvas for step diagrams
        self.crash_steps_frame = ttk.Frame(self.crash_steps_canvas)
        self.crash_steps_canvas.create_window((0, 0), window=self.crash_steps_frame, anchor="nw")

        # Make sure the scroll region updates
        def _on_frame_configure(event):
            self.crash_steps_canvas.configure(scrollregion=self.crash_steps_canvas.bbox("all"))
        self.crash_steps_frame.bind("<Configure>", _on_frame_configure)
    
    def display_crash_results(self, crashed_G, total_crash_cost, crash_log, target_duration):
        """Display crash log and summary in the crashing tab"""
        self.crash_results_text.delete(1.0, tk.END)
        lines = []
        lines.append("CRASHING OPTIMIZATION LOG\n" + "="*40)
        for entry in crash_log:
            lines.append(f"Step {entry['iteration']}: Activity {entry['activity']} crashed to duration {entry['new_duration']} (Cost: {entry['crash_cost']})")
        lines.append("\nTotal Crash Cost: {:.2f}".format(total_crash_cost))
        new_duration = max([crashed_G.nodes[node]['EF'] for node in crashed_G.nodes()])
        lines.append(f"Achieved Project Duration: {new_duration} (Target: {target_duration})")
        # Show new critical path
        critical_activities = [node for node in crashed_G.nodes() if crashed_G.nodes[node]['float'] == 0 and node not in ['START', 'END']]
        lines.append("New Critical Path: " + " -> ".join(critical_activities))
        self.crash_results_text.insert(1.0, "\n".join(lines))
    
    def generate_crashed_network_diagram(self, crashed_G, crash_log):
        """Show the crashed network diagram"""
        self.fig_crashed.clear()
        ax = self.fig_crashed.add_subplot(111)
        
        # Create hierarchical layout
        pos = {}
        generations = list(nx.topological_generations(crashed_G))
        for i, gen in enumerate(generations):
            sorted_gen = sorted(gen)
            for j, node in enumerate(sorted_gen):
                y_pos = (j - len(sorted_gen) / 2 + 0.5) * 4
                pos[node] = (i * 3, y_pos)

        node_radius = 0.4

        # Draw edges
        for u, v in crashed_G.edges():
            x1, y1 = pos[u]
            x2, y2 = pos[v]
            dx = x2 - x1
            dy = y2 - y1
            distance = (dx ** 2 + dy ** 2) ** 0.5
            if distance > 0:
                dx_norm = dx / distance
                dy_norm = dy / distance
                start_x = x1 + node_radius * dx_norm
                start_y = y1 + node_radius * dy_norm
                end_x = x2 - node_radius * dx_norm
                end_y = y2 - node_radius * dy_norm
                ax.annotate("", xy=(end_x, end_y), xytext=(start_x, start_y),
                            arrowprops=dict(arrowstyle="->", color="black", lw=1.5))

        # Draw nodes
        critical_activities = [node for node in crashed_G.nodes() if crashed_G.nodes[node]['float'] == 0 and node not in ['START', 'END']]
        for node in crashed_G.nodes():
            x, y = pos[node]
            if node == 'START':
                color = 'lightgreen'
            elif node == 'END':
                color = 'orange'
            elif node in critical_activities:
                color = 'red'
            else:
                color = 'lightblue'
            circle = plt.Circle((x, y), node_radius, fill=True, color=color, alpha=0.7,
                                edgecolor='black', linewidth=1.5)
            ax.add_patch(circle)
            if node in ['START', 'END']:
                display_text = 'Start' if node == 'START' else 'End'
                ax.text(x, y, display_text, ha='center', va='center',
                        fontsize=10, fontweight='bold')
            else:
                ax.plot([x - node_radius, x + node_radius], [y, y],
                        color='black', linewidth=1.2)
                ax.text(x, y + node_radius / 2, node, ha='center', va='center',
                        fontsize=10, fontweight='bold')
                ax.text(x, y - node_radius / 2, str(crashed_G.nodes[node]['duration']),
                        ha='center', va='center', fontsize=9)

        ax.set_title("Crashed Project Network Diagram")
        ax.axis('equal')
        ax.axis('off')
        self.canvas_crashed.draw()

    def show_crashing_steps_diagrams(self, crashed_G, crash_log):
        """Display a network diagram for every step of the crashing process, two per row, scrollable."""
        # Remove previous widgets if any
        for widget in self.crash_steps_frame.winfo_children():
            widget.destroy()

        # Create a canvas and a vertical scrollbar inside the dedicated frame
        canvas = tk.Canvas(self.crash_steps_frame, height=600)
        scrollbar = ttk.Scrollbar(self.crash_steps_frame, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        # Create a frame inside the canvas
        steps_frame = ttk.Frame(self.crash_steps_canvas)
        self.crash_steps_canvas.create_window((0, 0), window=steps_frame, anchor="nw")

        # Prepare all step graphs
        step_graphs = []
        G = self.analyzer.G.copy()
        for i, entry in enumerate(crash_log):
            # Apply all crashes up to this step
            G = G.copy()
            G.nodes[entry['activity']]['duration'] = entry['new_duration']
            G = self.analyzer.forward_pass(G)
            G = self.analyzer.backward_pass(G)
            G = self.analyzer.calculate_float(G)
            step_graphs.append((i+1, entry['activity'], entry['new_duration'], G))

        # Store references to images to prevent garbage collection
        self.crash_step_images = []

        # For each step, create a Matplotlib figure and embed as image
        for idx, (step_num, activity, new_duration, G_step) in enumerate(step_graphs):
            fig = plt.Figure(figsize=(4, 3))
            ax = fig.add_subplot(111)
            # Use your existing network diagram logic
            self._draw_network_diagram_on_ax(ax, G_step)
            ax.set_title(f"Step {step_num}: {activity} → {new_duration}")

            # Convert Matplotlib figure to Tkinter image
            canvas = agg.FigureCanvasAgg(fig)
            canvas.draw()
            buf = canvas.buffer_rgba()
            img = Image.frombuffer("RGBA", canvas.get_width_height(), buf, "raw", "RGBA", 0, 1)
            tk_img = ImageTk.PhotoImage(img)
            self.crash_step_images.append(tk_img)  # Prevent GC

            # Place in grid (2 per row)
            lbl = tk.Label(steps_frame, image=tk_img)
            lbl.grid(row=idx // 2, column=idx % 2, padx=10, pady=10)

        # Update scroll region
        steps_frame.update_idletasks()
        self.crash_steps_canvas.config(scrollregion=self.crash_steps_canvas.bbox("all"))

